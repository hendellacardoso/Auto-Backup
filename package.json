{
  "name": "api2dev-sistema-backup",
  "productName": "API2Dev Backup",
  "version": "1.0.0",
  "description": "Backups automáticos agendados para SQL Server, PostgreSQL, MySQL e Oracle",
  "author": {
    "name": "Hendell Cardoso - API2Dev",
    "email": "suporte@api2dev.com.br"
  },
  "homepage": "https://github.com/hendellacardoso/Auto-Backup",
  "repository": {
    "type": "git",
    "url": "https://github.com/hendellacardoso/Auto-Backup.git"
  },
  "bugs": {
    "url": "https://github.com/hendellacardoso/Auto-Backup/issues"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:ui": "vite build",
    "start": "npm run build:ui && electron .",
    "postinstall": "electron-builder install-app-deps && node scripts/download-winsw.js",
    "dist": "npm run build:ui && electron-builder --win nsis --x64 --publish never && electron-builder --win portable --x64 --publish never",
    "dist:setup": "npm run build:ui && electron-builder --win nsis --x64 --publish never",
    "dist:portable": "npm run build:ui && electron-builder --win portable --x64 --publish never",
    "dist:dir": "npm run build:ui && electron-builder --win dir --x64 --publish never",
    "dist:instaladores": "electron-builder --win nsis portable --x64 --prepackaged release/win-unpacked --publish never"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@googleapis/drive": "^8.14.0",
    "basic-ftp": "^5.0.5",
    "better-sqlite3": "^11.7.0",
    "google-auth-library": "^9.15.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.11.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "oracledb": "^6.7.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "br.com.api2dev.backup",
    "productName": "API2Dev Backup",
    "copyright": "Copyright © 2026 Hendell Cardoso - API2Dev (MIT License)",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/tray.png",
      "package.json",
      "!node_modules/7zip-bin/mac/**",
      "!node_modules/7zip-bin/linux/**",
      "!node_modules/7zip-bin/win/ia32/**",
      "!node_modules/7zip-bin/win/arm64/**",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "resources/service",
        "to": "service"
      }
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "Hendell Cardoso"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "API2Dev Backup",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "API2Dev-Backup-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "API2Dev-Backup-Portatil-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hendellacardoso",
        "repo": "Auto-Backup"
      }
    ]
  }
}
